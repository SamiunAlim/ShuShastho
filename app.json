{
  "expo": {
    "name": "ShuShastho",
    "slug": "ShuShastho",
    "scheme": "shushastho",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-status-bar",
      ["expo-audio", {"microphonePermission": "ShuShastho uses the microphone so you can speak your symptoms. · উপসর্গ বলার জন্য সুস্বাস্থ্য মাইক্রোফোন ব্যবহার করে।"}]
    ]
  }
}
